<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.payment.methods">
            <!-- The "as" must match the payment method code. The block class is the base module's, which provides the
                 config and paywall JSON the template reads. -->
            <block name="checkout.payment.method.comfino"
               as="comfino"
               class="Comfino\ComfinoGateway\Block\Payment\Comfino"
               template="Comfino_ComfinoGatewayHyvaCheckout::hyva-checkout/payment/comfino.phtml"
            >
                <arguments>
                    <!-- Keeps #comfino-loan-amount in sync with the quote total; Hyvä does not re-render payment templates on totals changes. -->
                    <argument name="magewire" xsi:type="object">Comfino\ComfinoGatewayHyvaCheckout\Magewire\Checkout\Payment\Method\Comfino</argument>
                </arguments>
            </block>
        </referenceBlock>
        <!--
            Registers the Alpine component and bootstraps the SDK once at page load from the CDN registrar. The payment template
            is morphed in by Magewire, which eval()s inline scripts (blocked by the CSP), so this needs a page-level <script src>
            (the CDN host is allow-listed).

            "hyva.checkout.api-v1.after" exists across 1.0.x-1.3.x; the more specific "api-v1.payment-methods" container only since
            1.3.6, and using it left the SDK unbootstrapped on older versions. The block uses the Comfino class so comfino-register.phtml
            can build the config server-side.
        -->
        <referenceContainer name="hyva.checkout.api-v1.after">
            <block name="checkout.payment.method.comfino.register"
               class="Comfino\ComfinoGateway\Block\Payment\Comfino"
               template="Comfino_ComfinoGatewayHyvaCheckout::hyva-checkout/payment/comfino-register.phtml">
                <arguments>
                    <argument name="paywall_bootstrap_config" xsi:type="object">Comfino\ComfinoGatewayHyvaCheckout\ViewModel\PaywallBootstrapConfig</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
