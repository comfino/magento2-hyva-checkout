<?xml version="1.0"?>
<!--
/**
 * Comfino Payment Gateway for Magento 2 with Hyvä Checkout
 *
 * Loads the Comfino payment-method loader styles into the checkout <head> so the spinner placeholder is styled at first
 * paint before the SDK runs:
 *   - the module's platform-specific positioning rule (static asset) via <head><css>;
 *   - the shared CDN-served comfino-checkout.css (dynamic URL) via a head.additional template.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Comfino_ComfinoGatewayHyvaCheckout::css/comfino-hyva-checkout.css"/>
    </head>
    <body>
        <referenceContainer name="head.additional">
            <block name="comfino.checkout.loader.styles"
                   class="Magento\Framework\View\Element\Template"
                   template="Comfino_ComfinoGatewayHyvaCheckout::hyva-checkout/payment/comfino-loader-styles.phtml">
                <arguments>
                    <argument name="loader_styles" xsi:type="object">Comfino\ComfinoGatewayHyvaCheckout\ViewModel\LoaderStyles</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>