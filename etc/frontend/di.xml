<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Hyva\Checkout\Model\Magewire\Payment\PlaceOrderServiceProvider">
        <arguments>
            <argument name="placeOrderServiceList" xsi:type="array">
                <item name="comfino" xsi:type="object">
                    Comfino\ComfinoGatewayHyvaCheckout\Model\Checkout\PlaceOrderService
                </item>
            </argument>
        </arguments>
    </type>
    <!--
        Renders the Comfino logo placeholder plus a loader spinner into the Comfino payment-method tile's icon slot
        (method-list.phtml outputs MethodMetaData::renderIcon() as raw HTML), so the tile is never logo-less before
        the SDK paints the final item content.
    -->
    <type name="Hyva\Checkout\Model\MethodMetaData">
        <plugin name="comfino_render_payment_method_loader" type="Comfino\ComfinoGatewayHyvaCheckout\Plugin\Hyva\Checkout\Model\MethodMetaData\RenderComfinoLoader"/>
    </type>
</config>
